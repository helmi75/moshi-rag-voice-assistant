    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Contrôles de supervision",
   "description": "0 ok · 1 attention · 2 panne",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "helmane_supervision_niveau{controle!=\"global\"}",
     "legendFormat": "{{controle}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
