# Copiez ce fichier vers .env et remplissez avec vos vraies valeurs
# Commande: cp env.example .env

# Clé API OpenRouter (https://openrouter.ai/keys) — le cerveau de l'assistant.
# OpenRouter donne accès à Claude, GPT, Gemini, Llama, Mistral, DeepSeek... avec
# une seule clé, et propose des modèles gratuits pour tester sans dépenser.
OPENROUTER_API_KEY="sk-or-v1-..."

# Modèle utilisé (catalogue complet : https://openrouter.ai/models) :
#   openrouter/free                     -> gratuit, choisi automatiquement (défaut)
#   anthropic/claude-sonnet-5           -> Claude
#   openai/gpt-4o-mini                  -> GPT
#   google/gemini-2.0-flash-001         -> Gemini
#   meta-llama/llama-3.3-70b-instruct   -> open source
# LLM_MODEL=openrouter/free

# En-têtes d'attribution optionnels (visibles dans le classement OpenRouter)
# OPENROUTER_SITE_URL=https://mondomaine.fr
# OPENROUTER_APP_NAME=Mon assistant vocal

# Configuration Twilio
TWILIO_ACCOUNT_SID="your_account_sid_here"
TWILIO_AUTH_TOKEN="your_auth_token_here"
# Numéro Twilio du tenant de démonstration (format E.164)
TWILIO_NUMBER=+33100000000
# Signature des requêtes Twilio (X-Twilio-Signature) : vérifiée dès qu'un jeton existe.
# PUBLIC_URL = l'origine publique EXACTE configurée dans la console Twilio ; sans elle,
# dérivée de PUBLIC_WS_URL. Après un déploiement, observer 48 h en « log » (la sonde
# /supervision compte ce qui aurait été refusé), puis retirer la ligne : enforce.
# PUBLIC_URL=https://assistant.mondomaine.fr
# TWILIO_SIGNATURE=log

# ── Pipeline vocal ────────────────────────────────────────────────
# Un seul chemin d'appel : Twilio Media Streams → Pipecat (Deepgram pour entendre, le LLM
# pour comprendre, la voix Moshi pour parler). URL WebSocket publique annoncée à Twilio
# (votre domaine derrière Caddy ; en test derrière ngrok : wss://xxxx.ngrok-free.app/ws/voice).
# Sans elle, l'appel raccroche sans un mot — la supervision l'exige.
# PUBLIC_WS_URL=wss://assistant.mondomaine.fr/ws/voice

# ── Production / hébergement 24/7 (VPS EU derrière Caddy) — voir docs/DEPLOY.md ──
# Adresse d'écoute de Caddy. En local : laisser vide (=> ":80", HTTP simple).
# En prod : votre domaine -> Caddy obtient/renouvelle un certificat HTTPS Let's Encrypt seul.
# SITE_ADDRESS=assistant.mondomaine.fr
# Cookies de session HTTPS-only une fois le domaine en place :
# SESSION_SECURE=1
# Réglages de naturalité de la conversation (défauts déjà validés, à affiner au besoin) :
# USER_TURN_STOP_TIMEOUT=2.0   # attendre quand smart-turn dit « pas fini » (mesuré : il a raison 62 % du temps)
# VAD_CONFIDENCE=0.85
# VAD_STOP_SECS=0.5
# Ce qui coupe la parole à l'assistante : "mots" (défaut, une vraie
# transcription) ou "voix" (tout son, y compris un souffle).
# INTERRUPTION=mots

# ── Transcription : Deepgram nova-3 en flux ──────────────────────────────────
# DEEPGRAM_API_KEY=...
# DEEPGRAM_MODEL=nova-3
# Langue : vide (défaut) = décroché bilingue, puis voice/langue.py fixe la langue de
# l'appel ; « fr » ou « en » l'impose pour tout l'appel.
# DEEPGRAM_LANGUAGE=
# Boost de vocabulaire supplémentaire (nom du resto + lexique résa déjà inclus) :
# DEEPGRAM_KEYWORDS=carbonara:5,osso buco:5

# ── Voix : Moshi 1.6B via le serveur Rust moshi-server (Modal GPU) ───────────
# L'app est simple cliente websocket ; le serveur Rust (la vraie voix d'unmute.sh) tourne
# sur Modal GPU et tient le temps réel. Déploiement : docs/MODAL.md
# (deploy/modal_moshi_server.py). Renseigner l'URL publique du serveur Modal :
# MOSHI_TTS_URL=wss://<vous>--moshi-server-....modal.run   # http(s):// accepté aussi
# MOSHI_TTS_API_KEY=public_token          # doit correspondre au token du serveur
# Voix par DÉFAUT DU PARC : servie aux établissements qui n'ont rien choisi dans
# l'admin (écran « Voix & accueil » — le choix par établissement prime). La valeur
# doit figurer au catalogue (api/app/voice/voices.py) : ailleurs elle est ignorée,
# car moshi-server remplacerait en silence une voix inconnue par sa voix de repli.
# MOSHI_TTS_VOICE=unmute-prod-website/developpeuse-3.wav

# --- Plateforme admin (dashboard /admin) --------------------------------------
# Compte super-admin semé au 1er démarrage. Sans ADMIN_PASSWORD, l'admin est
# inaccessible (l'app vocale n'est pas affectée). JAMAIS de vraie valeur ici.
# ADMIN_PASSWORD=choisissez-un-mot-de-passe-fort
# ADMIN_EMAIL=admin@local
# SESSION_SECRET=64-hex-aleatoires   # openssl rand -hex 32
# SESSION_SECURE=1                   # cookies HTTPS only (prod avec domaine)
# Coûts estimés affichés dans le journal des appels (calés sur les mesures réelles) :
# COST_TWILIO_PER_MIN=0.0085
# COST_DEEPGRAM_PER_MIN=0.0058
# COST_MODAL_PER_MIN=0.02
# COST_LLM_PER_CALL=0.0035

# --- Supervision (#24) --------------------------------------------------------
# Jeton de la sonde /supervision, interrogée depuis GitHub Actions toutes les 15 min
# (.github/workflows/supervision.yml). SANS CE JETON, LA SONDE RÉPOND 404 : rien n'est
# surveillé. La même valeur doit être posée en secret GitHub (SUPERVISION_TOKEN).
# Générer : openssl rand -hex 32          — JAMAIS de vraie valeur dans ce fichier.
# Le gabarit est écrit en toutes lettres plutôt que sous forme de valeur : un scanner de
# secrets lit `TOKEN=<chaîne>` comme une fuite, et un faux positif qu'on prend l'habitude
# d'ignorer coûte plus cher qu'une ligne moins jolie.
# SUPERVISION_TOKEN = les 64 caractères hexadécimaux rendus par la commande ci-dessus
#
# Fenêtre d'observation. 7 jours et non 30 : une alerte doit parler du présent.
# SUPERVISION_FENETRE_JOURS=7
#
# Seuils. Chacun décide d'un passage au rouge, donc chacun doit pouvoir bouger : un
# seuil qu'on ne peut pas régler finit par être ignoré, ce qui revient à ne rien avoir.
# SUPERVISION_MUET_SECONDES=15           # en deçà, c'est un raccroché, pas une panne
# SUPERVISION_INACHEVE_MINUTES=30        # au-delà, l'appel n'est plus « en cours »
# SUPERVISION_LATENCE_ATTENTION_MS=2500  # mesuré en prod : 1160 ms de blanc médian
# SUPERVISION_LATENCE_PANNE_MS=4000
# SUPERVISION_SAUVEGARDE_ATTENTION_H=36  # le cron passe à 04h00
# SUPERVISION_SAUVEGARDE_PANNE_H=72      # deux nuits manquées
#
# Relève des alertes Twilio (webhook injoignable, TwiML invalide) : le SEUL angle mort
# que rien d'autre ne couvre, puisque ces appels meurent avant d'atteindre l'app.
# Lecture gratuite de l'API Monitor, avec les identifiants Twilio déjà configurés.
# SUPERVISION_TWILIO_SECONDES=900        # 0 désactive la relève
#
# Jeton de fraîcheur des sauvegardes, écrit par scripts/backup-db.sh dans le volume.
# SUPERVISION_BACKUP_STAMP=/app/data/derniere-sauvegarde

# --- Données personnelles / RGPD (#22) ----------------------------------------
# Durées de conservation, APPLIQUÉES par une purge automatique (api/app/rgpd.py) et
# vérifiées par la supervision. Une durée qu'aucun code n'applique est pire que pas de
# durée : elle donne une réponse fausse à qui la demande. Cf. docs/RGPD.md.
# RETENTION_TRANSCRIPT_JOURS=30    # le transcript ne sert qu'au diagnostic
# RETENTION_NUMERO_JOURS=90        # rappeler un client, retrouver sa réservation
# RETENTION_RESERVATION_JOURS=365  # compté sur la DATE de la table, pas sa création
# RETENTION_INTERVALLE_SECONDES=86400   # 0 = purge désactivée (la supervision le signale)
#
# Mention d'information au décroché : « Cet accueil est assuré par un assistant vocal ;
# votre appel est traité pour votre réservation. » Activée par défaut. La couper est une
# décision juridique, pas un réglage de confort — sans elle, l'appelant ignore qu'il
# parle à une machine et que ce qu'il dit est traité.
# RGPD_MENTION=1

# --- Enregistrement des appels et journal de bord (#88) -----------------------
# Enregistre les deux voix (appelant / assistante) en pistes SÉPARÉES, pour pouvoir
# réécouter un appel raté et le disséquer. Défaut 0 : la fonctionnalité s'allume
# explicitement.
#
# ⚠️ L'activer CHANGE la mention entendue au décroché (« votre appel est enregistré et
# traité »), donc la clé de cache des accueils : tous les WAV sont re-rendus au démarrage
# suivant. Compter ~58 s de GPU une fois, et ne pas déclarer le déploiement terminé avant
# que le contrôle « Voix d'accueil » de la supervision soit repassé à N / N.
#
# On n'enregistre JAMAIS sans l'annoncer : `RGPD_MENTION=0` coupe aussi l'enregistrement.
# ENREGISTREMENT_APPELS=0
# ENREGISTREMENT_DIR=/app/data/enregistrements
# ENREGISTREMENT_MAX_SECONDES=900      # au-delà on cesse d'écrire ; l'appel continue
# ENREGISTREMENT_DISQUE_MINIMUM_MO=2000  # en dessous, aucun enregistrement
#
# Conservation de la voix. PLAFONNÉE par RETENTION_TRANSCRIPT_JOURS : un enregistrement
# ne survit jamais au texte qu'il a produit, quel que soit le réglage ci-dessous.
# RETENTION_ENREGISTREMENT_JOURS=30
#
# Bornes du journal de bord (chronologie stockée par appel). Un appel pathologique ne
# doit gonfler ni la base ni les sauvegardes.
# JOURNAL_MAX_TOURS=100
# JOURNAL_MAX_EVENEMENTS=400
#
# Espace disque surveillé. ~3,4 Mo par appel de 3,5 min : à 50 appels/jour et 30 jours de
# rétention, environ 5 Go.
# SUPERVISION_DISQUE_ATTENTION_MO=10000
# SUPERVISION_DISQUE_PANNE_MO=2000
